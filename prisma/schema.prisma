// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConsultationType {
  CLINIC
  ONLINE
}

enum AvailabilityConsultationType {
  CLINIC
  ONLINE
  BOTH
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  ONLINE
  PAY_AT_CLINIC
}

enum BookingSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  /// Payment succeeded but the slot was taken before the appointment could be created.
  FAILED
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  REFUND_FAILED
  DOCTOR_PENDING_APPROVAL
  CAREERS_NEW_APPLICATIONS
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  REJECTED
  HIRED
}

enum AiRecommendation {
  SHORTLIST
  REJECT
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ChatSenderRole {
  PATIENT
  DOCTOR
}

model User {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  address   String?
  email     String   @unique
  /// When set, the user can sign in with credentials.
  emailVerifiedAt DateTime?
  /// Hash of the email verification token sent to the user's email.
  /// Null for accounts that don't require verification (e.g. OAuth sign-ins).
  emailVerificationTokenHash     String?
  emailVerificationTokenExpiresAt DateTime?
  /// Hash of password reset token for one-time reset flows.
  passwordResetTokenHash     String?
  passwordResetTokenExpiresAt DateTime?
  /// Passwordless email (magic link) sign-in — raw token is never stored.
  magicLinkTokenHash     String?
  magicLinkTokenExpiresAt DateTime?
  /// Throttle magic-link email sends per user.
  magicLinkLastSentAt DateTime?
  /// Proposed login email while an admin email change awaits confirmation (mailed link).
  pendingEmail String?
  /// Hash of one-time token to confirm `pendingEmail` (raw token never stored).
  emailChangeTokenHash String?
  emailChangeTokenExpiresAt DateTime?
  /// Null for OAuth-only accounts (e.g. Google sign-in).
  password  String?
  role      UserRole @default(PATIENT)
  /// Admin dashboard revenue display currency preference (ISO 4217).
  /// When null, currency can be supplied by client context (for example, browser detection).
  preferredCurrency String?
  profileComplete Boolean @default(true)
  /// Google Calendar OAuth for admin interview Meet links.
  googleCalendarAccessToken          String?   @db.Text
  googleCalendarRefreshToken         String?   @db.Text
  googleCalendarAccessTokenExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthProfile HealthProfile?
  doctor        Doctor?
  notifications Notification[]
  patientReviews Review[] @relation("PatientReviews")
  chatReadStates    ChatReadState[]
}

model HealthProfile {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Personal
  bloodGroup   String?
  heightCm     Float?
  weightKg     Float?
  dateOfBirth  DateTime? @db.Date
  gender       String?

  /// Medical history
  allergies            String? @db.Text
  conditions           String? @db.Text
  currentMedications   String? @db.Text
  pastSurgeries        String? @db.Text
  smokingStatus        String?
  alcoholUse           String?
  activityLevel        String?

  /// Emergency contacts
  emergencyContactName             String?
  emergencyContactPhone            String?
  emergencyContactRelationship     String?
  emergencyContact2Name            String?
  emergencyContact2Phone           String?
  emergencyContact2Relationship    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id               String               @id @default(cuid())
  /// Set when this row is tied to a user account (doctor signup); null for seeded doctors.
  userId           String?              @unique
  user             User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  /// URL segment for public profile `/doctors/[slug]`. Set when approved (or seeded catalog).
  slug             String?              @unique
  /// Contact phone for clinic / admin search.
  phone            String
  specialization   String
  /// Doctor degree / qualification (e.g., "MBBS, MD").
  qualification    String
  licenseNumber    String
  yearsExperience  Int?
  bio              String?              @db.Text
  profilePhotoUrl  String
  /// IANA timezone for the doctor's clinic (e.g. "America/New_York").
  /// All availability times and stored appointment times are in this timezone.
  timezone         String               @default("UTC")
  /// Length of each bookable slot (minutes). Used when generating and displaying slots.
  slotDurationMinutes Int               @default(30)
  /// Doctor consultation fees in cents for online appointments, keyed by slot
  /// duration in minutes ("15" | "30" | "45" | "60"). Allows different prices
  /// for different consultation lengths.
  consultationPriceCentsByDuration Json @default("{\"15\":1500,\"30\":3000,\"45\":4500,\"60\":6000}")
  /// ISO 4217 currency code (3 letters, uppercase) used to display prices and
  /// charge Stripe payments for this doctor. Auto-suggested from timezone but
  /// user-editable.
  currency         String               @default("USD")
  /// Cached review summary for public profile/listing displays.
  averageRating    Float                @default(0)
  reviewCount      Int                  @default(0)
  approvalStatus   DoctorApprovalStatus @default(PENDING)
  approvedAt       DateTime?
  approvedByUserId String?
  isActive         Boolean              @default(false)
  deactivatedAt    DateTime?
  deactivatedByUserId String?
  lastSeenAt       DateTime?
  /// Doctor Google Calendar OAuth — set when the doctor connects Google Calendar from their dashboard.
  googleCalendarAccessToken          String?   @db.Text
  googleCalendarRefreshToken         String?   @db.Text
  googleCalendarAccessTokenExpiresAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  availabilities   DoctorAvailability[]
  appointments     Appointment[]
  bookingSessions  BookingSession[]
  customMedicines  CustomMedicine[]
  reviews          Review[]
}

model Review {
  id        String   @id @default(cuid())
  patientId String
  patient   User     @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([doctorId, createdAt(sort: Desc)])
  @@index([rating])
  @@index([createdAt(sort: Desc)])
}

model DoctorAvailability {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  startTime String
  endTime   String
  /// Slot duration (minutes) used when this availability row was created.
  slotDurationMinutes Int @default(30)
  /// Consultation mode available for this availability window.
  consultationType AvailabilityConsultationType @default(BOTH)

  @@index([doctorId, consultationType, date])
}

model Appointment {
  id               String            @id @default(cuid())
  doctorId         String
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientName      String
  email            String
  phone            String
  /// Doctor's IANA timezone — date + time are stored in this timezone (e.g. "America/New_York")
  timezone         String            @default("UTC")
  /// Patient's IANA timezone for displaying times in emails (e.g. "Asia/Kolkata")
  patientTimezone  String            @default("UTC")
  date             DateTime          @db.Date
  time             String
  /// Frozen slot duration at booking time (minutes), used for event timings and display.
  durationMinutes  Int               @default(30)
  /// Snapshot of the doctor's consultation fee at appointment creation (in cents).
  /// This value is immutable historical booking data for reporting.
  priceCentsAtBooking Int?
  /// Snapshot of the doctor's consultation fee currency at appointment creation.
  currencyAtBooking   String?
  notes            String?
  prescription     Prescription?
  review           Review?
  consultationType ConsultationType
  status           AppointmentStatus @default(PENDING)
  paymentStatus    PaymentStatus     @default(PENDING)
  /// How the patient chose to pay: ONLINE (Stripe) or PAY_AT_CLINIC.
  /// Null for historical rows created before this field was added.
  paymentMethod    PaymentMethod?
  stripePaymentId       String?
  /// Stripe PaymentIntent id resolved from the checkout session once needed for a refund.
  /// Cached on the appointment to avoid re-fetching the session for future refund-related calls.
  stripePaymentIntentId String?
  /// Id of the Stripe refund most recently created for this appointment.
  stripeRefundId        String?
  /// Refund lifecycle state mirrored from Stripe refund webhook events.
  refundStatus          RefundStatus?
  /// Amount refunded in cents (full or 50% of the charge).
  refundAmountCents     Int?
  cancelToken      String?
  rescheduleToken  String?
  overdueInAppNotifiedAt DateTime?
  overdueEmailNotifiedAt DateTime?
  /// Google Meet join URL (from Calendar API when consultation is online).
  googleMeetUrl           String?
  /// Calendar event id for patch/delete on reschedule or cancel.
  googleCalendarEventId   String?
  createdAt        DateTime          @default(now())
  chatConversation ChatConversation?

  /// DB enforces at most one non-cancelled row per (doctorId, date, time) via partial unique index
  /// `Appointment_doctorId_date_time_active_key` (see migrations).
  @@index([status, date, time])
}

model ChatConversation {
  id                    String    @id @default(cuid())
  appointmentId         String    @unique
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  twilioConversationSid String?   @unique
  doctorUserId          String
  patientUserId         String?
  completedAt           DateTime
  lockedAt              DateTime?
  hiddenFor             String[]  @default([])
  isArchivedByDoctor    Boolean   @default(false)
  createdAt             DateTime  @default(now())

  messages   ChatMessage[]
  readStates ChatReadState[]
  hideStates ChatConversationHideState[]

  @@index([doctorUserId])
  @@index([patientUserId])
}

model ChatConversationHideState {
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  hiddenAt       DateTime

  @@id([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id               String         @id @default(cuid())
  conversationId   String
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  twilioMessageSid String         @unique
  senderUserId     String
  senderRole       ChatSenderRole
  body             String         @db.Text
  messageType      String         @default("text")
  imageKey               String?
  isDeletedForEveryone   Boolean        @default(false)
  deletedFor             String[]       @default([])
  createdAt              DateTime       @default(now())

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderUserId])
}

model ChatReadState {
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime

  @@id([conversationId, userId])
}

model Prescription {
  appointmentId String      @id
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicines     Json
  generalNotes  String?     @db.Text
}

model CustomMedicine {
  id                String   @id @default(cuid())
  name              String
  createdByDoctorId String   @map("created_by_doctor_id")
  createdByDoctor   Doctor   @relation(fields: [createdByDoctorId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([createdByDoctorId, createdAt(sort: Desc)])
  @@map("custom_medicines")
}

model BookingSession {
  id               String               @id @default(uuid())
  doctorId         String
  doctor           Doctor               @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patientName      String
  email            String
  phone            String
  /// Doctor's IANA timezone — date + time are stored in this timezone (e.g. "America/New_York")
  timezone         String               @default("UTC")
  /// Patient's IANA timezone for displaying times in emails (e.g. "Asia/Kolkata")
  patientTimezone  String               @default("UTC")
  date             String
  time             String
  /// Frozen slot duration at booking-session creation time (minutes).
  durationMinutes  Int               @default(30)
  /// Snapshot of the doctor's per-duration price (in cents) at session creation.
  /// Locks in the price the patient was shown, even if the doctor later edits
  /// their pricing map.
  priceCentsAtBooking Int?
  /// Snapshot of the doctor's currency (ISO 4217) at session creation.
  currencyAtBooking   String?
  notes            String?
  consultationType String
  status           BookingSessionStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  expiresAt        DateTime

  /// DB enforces at most one PENDING row per (doctorId, date, time) via partial
  /// unique index `BookingSession_doctorId_date_time_pending_key` (see migrations).
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  /// User id who initiated the action that produced this notification.
  /// Null for system-triggered notifications (cron jobs, webhooks, etc.).
  /// Used to suppress live toasts when the recipient is also the actor.
  actorUserId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  description    String           @db.Text
  type           JobType
  isRemote       Boolean          @default(false)
  salaryRange    String?
  salaryCurrency String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  applications   JobApplication[]
}

model JobApplication {
  id               String            @id @default(cuid())
  jobPostingId     String
  jobPosting       JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  name             String
  email            String
  phone            String
  coverNote        String?           @db.Text
  resumeText       String            @db.Text
  resumeUrl          String?
  candidateTimezone  String?
  status             ApplicationStatus @default(PENDING)
  aiScore          Int?
  aiSummary        String?           @db.Text
  aiRecommendation AiRecommendation?
  createdAt        DateTime          @default(now())
  includedInDigest Boolean           @default(false)
  interviewRounds  InterviewRound[]

  @@index([jobPostingId, createdAt(sort: Desc)])
  @@index([includedInDigest])
  @@index([status, createdAt(sort: Desc)])
  @@index([aiScore, createdAt(sort: Desc)])
}

model InterviewRound {
  id                          String         @id @default(cuid())
  applicationId               String
  application                 JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundNumber                 Int
  scheduledAt                 DateTime
  timezone                    String         @default("UTC")
  meetLink                    String?
  confirmationToken           String         @unique
  confirmationTokenExpiresAt  DateTime?
  attendeeCancelToken         String?        @unique
  confirmedAt                 DateTime?
  notes                       String?        @db.Text
  attendeeEmail               String?
  attendeeName                String?
  jobDescriptionSnapshot      String         @db.Text
  googleCalendarEventId       String?
  scheduledByAdminId          String
  cancelledAt                 DateTime?
  cancellationReason          String?        @db.Text
  isCompleted                 Boolean        @default(false)
  createdAt                   DateTime       @default(now())

  // Unique (applicationId, roundNumber) only among non-cancelled rounds — see migration partial index.
  @@index([applicationId, roundNumber])
  @@index([confirmationToken])
}
